# Fineko Calendar — приклад .env (реальний .env у git не комітимо)
PORT=4800
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fineko_calendar
# SSO (OAuth-клієнт "calendar" реєструється в SSO через POST /admin/clients)
SSO_URL=http://localhost:4600
SSO_CLIENT_ID=calendar
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:4800/auth/callback
# Куди повертати після входу (адмінка). Dev: Vite на 5174; прод: https://calendar.fineko.space
ADMIN_BASE_URL=http://localhost:5174
# Інші origin, яким дозволені cookie-запити (через кому). Воронки ходять без cookie, їм це не потрібно.
ALLOWED_ORIGINS=http://localhost:5174
# Секрет для MCP-доступу власника/Claude (Bearer + ?tenantId=slug). Порожній = вимкнено.
MCP_SECRET=
