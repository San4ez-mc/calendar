{
  "name": "fineko-calendar",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=18" },
  "scripts": {
    "dev:api": "npm run dev -w @cal/api",
    "dev:admin": "npm run dev -w @cal/admin",
